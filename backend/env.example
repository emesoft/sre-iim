# Copy to infra/.env and fill in. Never commit the real .env (see .gitignore).
#   cp infra/env.example infra/.env

# --- Database ---
POSTGRES_DB=iim
POSTGRES_USER=iim
DB_PASSWORD=change-me
# For running the backend outside compose (host access):
# DATABASE_URL=postgresql+asyncpg://iim:change-me@localhost:5432/iim

# --- LLM provider (decision 0016): bedrock | deepseek | claude_cli ---
LLM_PROVIDER=bedrock
MAX_ROUNDS=2
CACHE_TTL_SECONDS=1800

# claude_cli — LOCAL DEMO ONLY, uses a Claude Code Pro/Max subscription instead of paid API access.
# Not for production (see backend/app/infrastructure/llm/claude_cli.py for why). Setup:
#   1. On the machine running `docker compose`, run: claude setup-token
#   2. Paste the printed token into the app's Settings page (not into this file) — it's encrypted
#      and stored in Postgres, read at call time by the claude_cli provider.
# CLAUDE_CLI_MODEL=sonnet

# Bedrock (Claude) — default; only hard AWS dependency. Needs an AWS account with Bedrock model
# access granted for MODEL_ID/FAST_MODEL_ID in AWS_REGION (console: Bedrock -> Model access ->
# request access to the Anthropic models; approval is usually instant). No API key — auth is via
# the default AWS credential chain (env vars, ~/.aws/config profile, or IAM role), same host
# credentials as the AWS connections used for CloudWatch. Some regions (e.g. ap-southeast-1) may
# require an inference-profile-prefixed model id (e.g. apac.anthropic.claude-...) instead of the
# bare one below — check the Bedrock console if a call 404s.
AWS_REGION=ap-southeast-1
MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
FAST_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Fernet key for encrypting cloud-connection access keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Settings-page admin gate ---
# A single shared password (not per-user accounts) that gates the Settings page (AWS connections,
# the claude_cli token). ADMIN_JWT_SECRET signs the session token — any random string works, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# DeepSeek (OpenAI-compatible) — for local testing without AWS. The base URL is configurable, so
# this same adapter drives any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama) — see below.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter (free-tier models) — set LLM_PROVIDER=deepseek and repoint the base URL:
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_MODEL=openai/gpt-oss-20b:free
# DEEPSEEK_API_KEY=sk-or-...
# Which models are free changes over time — a retired one returns HTTP 404 "unavailable for free",
# not an auth error. List the current ones with:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'

# --- Embedding provider (decision 0016): titan | jina ---
# One database serves one embedding dimension; changing it needs a schema resize (migration 0002).
EMBEDDING_PROVIDER=titan
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
# Jina (jina-embeddings-v3 = 768-dim). Get a free-tier key (no card required) at
# https://jina.ai/embeddings -> Get API key. Free tier is rate-limited but enough for demo/dev use.
# EMBEDDING_PROVIDER=jina
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_DIM=768
# JINA_API_KEY=

# --- Demo mode ---
# Global switch: serve synthetic log lines instead of querying a cloud, so the incident log-search
# action works with no AWS account and no per-project block below. Demo/dev only.
# DEMO_LOGS=true

# --- Per-project cloud config (log search) ---
# Each incident's `service` can live on a different cloud/account. Undeclared projects fall back
# to AWS_REGION + the default credential chain; only AWS is wired today (Azure/GCP later).
# AWS profiles come from the host's `~/.aws/config` (SSO) — run `aws sso login --profile <name>`
# before searching logs for that project; the container only reads the cached SSO token
# (mounted read-only in docker-compose.yml).
# PROJECT_GCM_CLOUD=aws
# PROJECT_GCM_AWS_PROFILE=GCM-Prod-ReadOnlyAccess
# PROJECT_GCM_AWS_REGION=ap-southeast-1

# --- Auth (M6) — NOT IMPLEMENTED YET, no code reads these vars ---
# Placeholder for a future real login (the frontend Login page is UI-only today — any email signs
# in). Do not set these expecting them to do anything; ADMIN_PASSWORD/ADMIN_JWT_SECRET above are the
# only auth that's actually wired up (gates the Settings page).
# JWT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# Azure DevOps ticketing (one-click ticket for a new/unseen error) is configured per internal
# project on the Settings page now, not here — see infrastructure/tickets/ado_client.py.
